# Copia este archivo como .env y rellena tus datos. El .env no se sube a git.

# Client ID de la aplicación pública registrada en https://dev.twitch.tv/console
# (Client Type: Public). No es secreto; se usa para iniciar sesión con Twitch.
TWITCH_CLIENT_ID=

# Cliente OAuth de Google de tipo "App de escritorio" (Google Cloud Console → Google Auth
# Platform → Clients), con la YouTube Data API v3 activada y la app "In production".
# En apps de escritorio Google no trata el secreto como confidencial, pero no se sube a git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional, solo la primera vez: canal de Twitch que se guarda en la configuración
# si aún no hay ninguno. Después se cambia desde la pantalla de configuración.
TWITCH_CHANNEL=
