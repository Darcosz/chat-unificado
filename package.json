{
  "name": "chat-unificado",
  "version": "0.2.0",
  "description": "Chat y alertas de Twitch, TikTok, YouTube y Kick en una sola ventana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "start:demo": "npm run build && electron . --demo",
    "server": "npm run build:ui && node --env-file-if-exists=.env src/main.ts",
    "demo": "npm run build:ui && node --env-file-if-exists=.env src/main.ts --demo",
    "console": "node --env-file-if-exists=.env src/console.ts",
    "build": "npm run build:ui && npm run build:backend",
    "build:ui": "tsc -p tsconfig.ui.json",
    "build:backend": "tsc -p tsconfig.backend.json && node -e \"require('fs').copyFileSync('src/youtube/stream-list.proto','dist/backend/youtube/stream-list.proto')\" && node scripts/embed-credentials.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "electron-updater": "^6.8.11",
    "tiktok-live-connector": "^2.5.0",
    "tmi.js": "^1.8.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "productName": "Chat Unificado",
  "author": "darco",
  "main": "dist/backend/desktop/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darcosz/chat-unificado.git"
  },
  "build": {
    "appId": "com.darcosz.chatunificado",
    "productName": "Chat Unificado",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/ui/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.test.*",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Chat Unificado"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Darcosz",
        "repo": "chat-unificado"
      }
    ]
  }
}
