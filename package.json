{
  "name": "chat-unificado",
  "version": "0.1.0",
  "description": "Chat y alertas de Twitch, TikTok, YouTube y Kick en una sola ventana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build:ui && node --env-file-if-exists=.env src/main.ts",
    "demo": "npm run build:ui && node --env-file-if-exists=.env src/main.ts --demo",
    "console": "node --env-file-if-exists=.env src/console.ts",
    "build:ui": "tsc -p tsconfig.ui.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "tmi.js": "^1.8.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
